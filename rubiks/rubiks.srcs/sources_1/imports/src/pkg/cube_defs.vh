// =====================================================================
// cube_defs.vh  --  shared definitions (Verilog-2001 header)
// ---------------------------------------------------------------------
// Shared definitions for the 2x2 cube project. No ports, no logic.
// Every module includes it INSIDE the module, after the port list:
//
//     module foo (
//         input clk, ...
//     );
//     `include "cube_defs.vh"
//         ...
//     endmodule
//
// Each module gets its own copy of the localparams and functions.
// Do NOT add an `ifndef include guard: with a guard only the first
// module in the compile would see these names.
// Port widths stay as plain numbers ([71:0], [4:0] ...) because the
// include comes after the port list.
//
// CUBE LAYOUT  (cube[71:0] = 24 stickers x 3 bits)
//   sticker index s = face*4 + tile        (0..23)
//   sticker s lives at cube[s*3 +: 3]
//
// FACES  (Kociemba order U R F D L B)
//   U=0  R=1  F=2  D=3  L=4  B=5
//
// TILES inside a face are numbered CLOCKWISE, as seen in this net
// (each face viewed from outside the cube):
//
//               +----+----+
//               | 0  | 1  |
//               +- U -----+
//               | 3  | 2  |
//     +----+----+----+----+----+----+----+----+
//     | 0  | 1  | 0  | 1  | 0  | 1  | 0  | 1  |
//     +- L -----+- F -----+- R -----+- B -----+
//     | 3  | 2  | 3  | 2  | 3  | 2  | 3  | 2  |
//     +----+----+----+----+----+----+----+----+
//               | 0  | 1  |
//               +- D -----+
//               | 3  | 2  |
//               +----+----+
//
//   Clockwise numbering means a clockwise face turn is just
//   tile i -> tile (i+1) mod 4 on that face (plus the side cycle).
//
// TICKS  (named by rate, all generated by tick_gen)
//   tick_25mhz, tick_1khz, tick_4hz : 1-cycle enable pulses on the
//                                     100 MHz clock, not clocks
//   clk_6p25mhz                     : real clock, OLED driver only
//
// VGA COLOUR  vga_rgb[11:0] = {r[3:0], g[3:0], b[3:0]}
//   top_basys3 splits it onto the board pins:
//   assign {vgaRed, vgaGreen, vgaBlue} = vga_rgb;
//
// STICKER IDs are 5 bits wide everywhere: [4:0]
// =====================================================================

    // -----------------------------------------------------------------
    // Widths
    // -----------------------------------------------------------------
    localparam CUBE_W     = 72;   // cube bus width
    localparam RGB_W      = 12;   // vga_rgb width, 4 bits per channel
    localparam N_STICKERS = 24;
    localparam N_FACES    = 6;
    localparam N_MOVES    = 18;
    localparam N_CORNERS  = 8;
    // -----------------------------------------------------------------
    // Camera angle, projection, and cube rotation IDs
    // -----------------------------------------------------------------
    localparam CAMERA_ANGLE_ID_W    = 8;
    localparam CAMERA_ANGLE_BIN_W   = 4;
    localparam PROJECTION_ID_W     = 5;
    localparam PROJECTION_COUNT    = 28;
    localparam CUBE_ROTATION_ID_W  = 5;
    localparam CUBE_ROTATION_COUNT = 24;
    localparam CAMERA_YAW_STEPS    = 16;
    localparam CAMERA_PITCH_STEPS  = 16;
    localparam CAMERA_ANGLE_COUNT  = 256;

    function automatic [3:0] camera_angle_yaw_bin(
        input [CAMERA_ANGLE_ID_W-1:0] camera_angle_id
    );
        camera_angle_yaw_bin = camera_angle_id[3:0];
    endfunction

    function automatic [3:0] camera_angle_pitch_bin(
        input [CAMERA_ANGLE_ID_W-1:0] camera_angle_id
    );
        camera_angle_pitch_bin = camera_angle_id[7:4];
    endfunction

    // -----------------------------------------------------------------
    // Clock and tick dividers  (counts of 100 MHz cycles)
    // -----------------------------------------------------------------
    localparam CLK_HZ          = 100_000_000;
    localparam DIV_25MHZ       = CLK_HZ / 25_000_000;     // 4
    localparam DIV_1KHZ        = CLK_HZ / 1_000;          // 100_000
    localparam DIV_4HZ         = CLK_HZ / 4;              // 25_000_000
    localparam HALF_6P25MHZ    = CLK_HZ / 6_250_000 / 2;  // 8: toggle clk_6p25mhz every 8 cycles

    // -----------------------------------------------------------------
    // Face numbers [2:0]
    // -----------------------------------------------------------------
    localparam [2:0] FACE_U = 3'd0;
    localparam [2:0] FACE_R = 3'd1;
    localparam [2:0] FACE_F = 3'd2;
    localparam [2:0] FACE_D = 3'd3;
    localparam [2:0] FACE_L = 3'd4;
    localparam [2:0] FACE_B = 3'd5;

    // -----------------------------------------------------------------
    // Colour codes [2:0]   (0 = blank / no colour)
    // Solved cube: face f has colour f+1 (U white, R red, F green,
    //              D yellow, L orange, B blue)
    // -----------------------------------------------------------------
    localparam [2:0] COL_BLANK  = 3'd0;
    localparam [2:0] COL_WHITE  = 3'd1;
    localparam [2:0] COL_RED    = 3'd2;
    localparam [2:0] COL_GREEN  = 3'd3;
    localparam [2:0] COL_YELLOW = 3'd4;
    localparam [2:0] COL_ORANGE = 3'd5;
    localparam [2:0] COL_BLUE   = 3'd6;
    localparam [2:0] COL_SPARE  = 3'd7;   // unused / highlight

    // -----------------------------------------------------------------
    // Move codes [4:0]   code = face*3 + type
    //   type 0 = clockwise, 1 = counter-clockwise ('), 2 = half turn (2)
    // -----------------------------------------------------------------
    localparam [4:0] MV_U  = 5'd0,  MV_UP = 5'd1,  MV_U2 = 5'd2;
    localparam [4:0] MV_R  = 5'd3,  MV_RP = 5'd4,  MV_R2 = 5'd5;
    localparam [4:0] MV_F  = 5'd6,  MV_FP = 5'd7,  MV_F2 = 5'd8;
    localparam [4:0] MV_D  = 5'd9,  MV_DP = 5'd10, MV_D2 = 5'd11;
    localparam [4:0] MV_L  = 5'd12, MV_LP = 5'd13, MV_L2 = 5'd14;
    localparam [4:0] MV_B  = 5'd15, MV_BP = 5'd16, MV_B2 = 5'd17;
    localparam [4:0] MV_NONE = 5'd31;   // "no move"

    localparam [1:0] TURN_CW  = 2'd0;
    localparam [1:0] TURN_CCW = 2'd1;
    localparam [1:0] TURN_180 = 2'd2;

    // -----------------------------------------------------------------
    // Game stages [2:0]
    // -----------------------------------------------------------------
    localparam [2:0] ST_MENU       = 3'd0;
    localparam [2:0] ST_FREE       = 3'd1;
    localparam [2:0] ST_SCRAMBLING = 3'd2;
    localparam [2:0] ST_SOLVING    = 3'd3;
    localparam [2:0] ST_SOLVED     = 3'd4;
    localparam [2:0] ST_ERROR      = 3'd5;   // solver failed or timed out

    // -----------------------------------------------------------------
    // Button bit positions in btn[4:0] = {C, U, L, R, D}
    // -----------------------------------------------------------------
    localparam BTN_D = 0;
    localparam BTN_R = 1;
    localparam BTN_L = 2;
    localparam BTN_U = 3;
    localparam BTN_C = 4;

    // -----------------------------------------------------------------
    // Screen constants
    // -----------------------------------------------------------------
    localparam SCREEN_W = 640;
    localparam SCREEN_H = 480;

    // =================================================================
    // Whole-cube constants
    // (Verilog-2001 functions need at least one input, so this is a
    //  constant instead of solved_cube())
    // =================================================================

    // solved cube: every tile on face f has colour f+1
    //                         B          L          D          F          R          U
    localparam [71:0] SOLVED_CUBE = {{4{3'd6}}, {4{3'd5}}, {4{3'd4}}, {4{3'd3}}, {4{3'd2}}, {4{3'd1}}};

    // =================================================================
    // Sticker access
    // =================================================================

    // face + tile -> sticker index (0..23)
    function automatic [4:0] sticker_idx(input [2:0] face,
                                         input [1:0] tile);
        sticker_idx = {face, tile};   // face*4 + tile
    endfunction

    // read one sticker by sticker index
    function automatic [2:0] get_sticker(input [71:0] cube,
                                         input [4:0]  s);
        get_sticker = cube[s*3 +: 3];
    endfunction

    // read one sticker by face + tile
    function automatic [2:0] get_tile(input [71:0] cube,
                                      input [2:0]  face,
                                      input [1:0]  tile);
        get_tile = get_sticker(cube, sticker_idx(face, tile));
    endfunction

    // return a copy of cube with one sticker replaced
    function automatic [71:0] set_sticker(input [71:0] cube,
                                          input [4:0]  s,
                                          input [2:0]  colour);
        reg [71:0] c;
        begin
            c = cube;
            c[s*3 +: 3] = colour;
            set_sticker = c;
        end
    endfunction

    function automatic [71:0] set_tile(input [71:0] cube,
                                       input [2:0]  face,
                                       input [1:0]  tile,
                                       input [2:0]  colour);
        set_tile = set_sticker(cube, sticker_idx(face, tile), colour);
    endfunction

    // =================================================================
    // Whole-cube helpers
    // =================================================================

    // solved = every face is one colour (works for any orientation)
    function automatic is_solved(input [71:0] cube);
        integer f, t;
        begin
            is_solved = 1'b1;
            for (f = 0; f < N_FACES; f = f + 1)
                for (t = 1; t < 4; t = t + 1)
                    if (cube[(f*4+t)*3 +: 3] != cube[(f*4)*3 +: 3])
                        is_solved = 1'b0;
        end
    endfunction

    // =================================================================
    // Move helpers
    // =================================================================

    function automatic [2:0] move_face(input [4:0] m);
        move_face = m / 3;
    endfunction

    function automatic [1:0] move_type(input [4:0] m);
        move_type = m % 3;
    endfunction

    function automatic [4:0] make_move(input [2:0] face,
                                       input [1:0] typ);
        make_move = face*3 + typ;
    endfunction

    // inverse: X <-> X', X2 stays X2
    function automatic [4:0] move_inverse(input [4:0] m);
        case (move_type(m))
            TURN_CW:  move_inverse = m + 5'd1;
            TURN_CCW: move_inverse = m - 5'd1;
            default:  move_inverse = m;
        endcase
    endfunction

    function automatic move_is_valid(input [4:0] m);
        move_is_valid = (m < N_MOVES);
    endfunction

    // same face (used by scrambler/solver to avoid U then U')
    function automatic same_face(input [4:0] a,
                                 input [4:0] b);
        same_face = (move_face(a) == move_face(b));
    endfunction

    // opposite face pairs: U-D, R-L, F-B  (face and face+3)
    function automatic [2:0] opposite_face(input [2:0] f);
        opposite_face = (f < 3) ? f + 3'd3 : f - 3'd3;
    endfunction

    // =================================================================
    // Corners (for the solver)
    // ---------------------------------------------------------------
    // 8 corners, Kociemba order: URF UFL ULB UBR DFR DLF DBL DRB
    // Each corner lists 3 sticker indices: the U/D sticker first,
    // then the other two going CLOCKWISE around the corner.
    // Twist of a corner = position (0,1,2) of its U/D-coloured sticker.
    // A real cube has sum of twists % 3 == 0.
    // =================================================================
    function automatic [4:0] corner_sticker(input [2:0] c,
                                            input [1:0] k);
        reg [14:0] row;   // {k2, k1, k0}, 5 bits each
        begin
            case (c)
                3'd0: row = {5'd9,  5'd4,  5'd2 };   // URF : U2 R0 F1
                3'd1: row = {5'd17, 5'd8,  5'd3 };   // UFL : U3 F0 L1
                3'd2: row = {5'd21, 5'd16, 5'd0 };   // ULB : U0 L0 B1
                3'd3: row = {5'd5,  5'd20, 5'd1 };   // UBR : U1 B0 R1
                3'd4: row = {5'd7,  5'd10, 5'd13};   // DFR : D1 F2 R3
                3'd5: row = {5'd11, 5'd18, 5'd12};   // DLF : D0 L2 F3
                3'd6: row = {5'd19, 5'd22, 5'd15};   // DBL : D3 B2 L3
                default: row = {5'd23, 5'd6, 5'd14}; // DRB : D2 R2 B3
            endcase
            corner_sticker = row[k*5 +: 5];
        end
    endfunction

    // colours of a corner as {k2, k1, k0}
    function automatic [8:0] corner_colours(input [71:0] cube,
                                            input [2:0]  c);
        corner_colours = { get_sticker(cube, corner_sticker(c, 2'd2)),
                           get_sticker(cube, corner_sticker(c, 2'd1)),
                           get_sticker(cube, corner_sticker(c, 2'd0)) };
    endfunction

    // =================================================================
    // Colour -> 12-bit VGA RGB, same layout as vga_rgb:
    //   {r[3:0], g[3:0], b[3:0]}
    // =================================================================
    function automatic [11:0] colour_to_rgb(input [2:0] col);
        case (col)
            COL_WHITE:  colour_to_rgb = 12'hFFF;
            COL_RED:    colour_to_rgb = 12'hE00;
            COL_GREEN:  colour_to_rgb = 12'h0C2;
            COL_YELLOW: colour_to_rgb = 12'hFE0;
            COL_ORANGE: colour_to_rgb = 12'hF80;
            COL_BLUE:   colour_to_rgb = 12'h03E;
            COL_SPARE:  colour_to_rgb = 12'hF0F;   // magenta highlight
            default:    colour_to_rgb = 12'h333;   // blank = dark grey
        endcase
    endfunction

    // Colour -> 16-bit OLED RGB565
    function automatic [15:0] colour_to_565(input [2:0] col);
        case (col)
            COL_WHITE:  colour_to_565 = 16'hFFFF;
            COL_RED:    colour_to_565 = 16'hE000;
            COL_GREEN:  colour_to_565 = 16'h0644;
            COL_YELLOW: colour_to_565 = 16'hFFC0;
            COL_ORANGE: colour_to_565 = 16'hFC00;
            COL_BLUE:   colour_to_565 = 16'h019D;
            COL_SPARE:  colour_to_565 = 16'hF81F;
            default:    colour_to_565 = 16'h3186;
        endcase
    endfunction
